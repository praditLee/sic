---
import { getSessionClient } from "../lib/supabase";

// 1. เรียกใช้งาน Supabase ที่อ่าน Cookies ได้
const supabase = getSessionClient(Astro.request, Astro.cookies);

// 2. ขอข้อมูล User
const {
  data: { user },
} = await supabase.auth.getUser();

// 3. ถ้าไม่มี User เตะกลับไปหน้า Login ทันที (จะขึ้นรหัส [302] ใน Log)
if (!user) {
  return Astro.redirect("/login");
}
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<Layout title="กำลังตรวจสอบข้อมูล... | SIC 2026">
  <main class="flex-1 flex flex-col items-center justify-center bg-white">
    <div class="flex flex-col items-center">
      <div
        class="animate-spin rounded-full h-16 w-16 border-t-4 border-b-4 border-blue-600"
      >
      </div>
      <p class="mt-4 text-gray-600 font-medium">
        กำลังตรวจสอบสถานะผู้ใช้งาน...
      </p>
    </div>
  </main>

  <script>
    // ✅ 1. เปลี่ยนมาดึง supabase จากไฟล์ lib ของเรา (ตัวที่อ่าน Cookie เป็น)
    import { supabase } from "../lib/supabase";

    async function checkUserProfile() {
      // 1. เช็คว่าล็อกอินอยู่จริงไหม (ตอนนี้มันจะอ่านจาก Cookie ได้แล้ว!)
      const {
        data: { session },
        error: authError,
      } = await supabase.auth.getSession();

      if (authError || !session) {
        // ถ้าไม่ได้ล็อกอิน หรือเซสชันหมดอายุ ให้กลับไปหน้า Login
        window.location.href = "/login";
        return;
      }

      const userId = session.user.id;

      // 2. ไปดึงข้อมูลจากตาราง public.profiles
      const { data: profile, error: dbError } = await supabase
        .from("profiles")
        .select("is_profile_complete, occupation")
        .eq("id", userId)
        .single();

      if (dbError || !profile) {
        console.error("Error fetching profile:", dbError);
        window.location.href = "/login";
        return;
      }

      // 3. กฎเหล็กในการส่งตัว (Routing Logic)
      if (profile.is_profile_complete === true) {
        try {
          // ยิงไปขอตั๋ว SSO จาก API ของเรา
          const response = await fetch("/api/sso", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
          });

          const result = await response.json();

          if (result.url) {
            // ได้ตั๋วมาแล้ว พาเด้งไป Thinkific ทันที!
            window.location.href = result.url;
          } else {
            console.error("SSO failed:", result.error);
            alert(
              "ไม่สามารถเข้าสู่ระบบห้องเรียนได้: " +
                (result.error || "Unknown error"),
            );
          }
        } catch (err) {
          console.error("Fetch SSO error:", err);
        }
      } else {
        console.log("Profile Incomplete. Redirecting to Registration Form...");
        window.location.href = "/complete-profile";
      }
    }

    // รันฟังก์ชันทันทีที่โหลดหน้า
    checkUserProfile();
  </script>
</Layout>
