---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
---

<Layout title="แบบฟอร์มแสดงความประสงค์เข้าร่วมโครงการ">
  <main class="relative min-h-[450px] py-12 bg-blue-50">
    <div
      class="max-w-4xl mx-auto bg-white shadow-xl rounded-lg overflow-hidden"
    >
      <div class="p-12 text-center">
        <h2 class="text-lg">แบบฟอร์มแสดงความประสงค์เข้าร่วมโครงการ</h2>
        <h1 class="text-2xl font-bold mt-1">
          Samsung Innovation Campus ในปี 2569
        </h1>
        <div class="mb-6 mt-12 flex justify-center">
          <a
            href="/assets/SIC2569-agreement.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-6 py-3 text-base font-semibold text-white transition-all duration-300 bg-blue-600 rounded-lg shadow-md hover:bg-blue-700 hover:shadow-lg hover:-translate-y-1"
          >
            <svg
              class="w-5 h-5 mr-2"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              ></path>
            </svg>
            อ่านบันทึกข้อตกลง
          </a>
        </div>
        <p class="text-xs text-gray-800 text-center max-w-2xl mx-auto">
          บันทึกข้อตกลงการเข้าร่วม โครงการ Samsung Innovation Campus ในปี 2569
          และการรับทุนสนับสนุน
        </p>
      </div>

      <form
        id="reportForm"
        action="https://docs.google.com/forms/d/e/1FAIpQLSdBRh3lcfgxNoV3a9B-_97oQRT6tnQJ7XFxcKTZ9riAESW99Q/formResponse"
        method="POST"
        class="p-8 space-y-8"
        target="hidden_iframe"
        onsubmit="return handleSubmit(event)"
      >
        <section
          class="space-y-4 border p-6 rounded-lg bg-gray-50 border-gray-200"
        >
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700"
                >ชื่อ-สกุล *</label
              >
              <input
                type="text"
                name="entry.2120597359"
                required
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm border p-2 focus:border-indigo-500 focus:ring-indigo-500"
                placeholder="ระบุชื่อและนามสกุล"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700"
                >เบอร์โทรศัพท์ *</label
              >
              <input
                type="tel"
                name="entry.1652591964"
                required
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm border p-2 focus:border-indigo-500 focus:ring-indigo-500"
                placeholder="08X-XXX-XXXX"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700"
                >อีเมล *</label
              >
              <input
                type="email"
                name="entry.58179007"
                required
                placeholder="example@email.com"
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm border p-2 focus:border-indigo-500 focus:ring-indigo-500"
              />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700"
                >ชื่อโรงเรียน *</label
              >
              <input
                type="text"
                name="entry.381655348"
                required
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm border p-2 focus:border-indigo-500 focus:ring-indigo-500"
              />
            </div>

            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-gray-700"
                >ปีที่เข้าร่วมโครงการ *</label
              >

              <select
                name="entry.1095135974"
                required
                class="mt-1 block w-full border-gray-300 border p-2 rounded shadow-sm"
              >
                <option value="">--เลือก--</option>
                <option value="2567">ปี 2567</option>
                <option value="2568">ปี 2568</option>
              </select>
            </div>
          </div>

          <div class="pt-6">
            <label class="block text-sm font-medium text-gray-700 mb-3"
              >ระดับชั้นที่รับผิดชอบสอน (เลือกได้มากกว่า 1 ข้อ) *</label
            >
            <div class="flex flex-wrap gap-4">
              {
                ["ม.1", "ม.2", "ม.3"].map((grade) => (
                  <label class="inline-flex items-center bg-white border border-gray-200 px-3 py-2 rounded-md hover:bg-indigo-50 cursor-pointer transition">
                    <input
                      type="checkbox"
                      name="entry.193034328"
                      value={grade}
                      class="form-checkbox h-5 w-5 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500"
                    />
                    <span class="ml-2 text-gray-700">{grade}</span>
                  </label>
                ))
              }
            </div>
            <p id="grade-error" class="hidden text-red-500 text-sm mt-2">
              กรุณาเลือกระดับชั้นอย่างน้อย 1 ข้อ
            </p>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700"
              >จำนวนนักเรียนทั้งหมดที่คาดว่าจะได้สอน (คน) *</label
            >
            <input
              type="number"
              name="entry.2060978043"
              required
              class="mt-1 block w-full md:w-1/2 rounded-md border-gray-300 shadow-sm border p-2 focus:border-indigo-500 focus:ring-indigo-500"
              placeholder="เช่น 200"
            />
          </div>
        </section>

        <section
          class="space-y-4 border p-6 rounded-lg bg-blue-50 border-blue-200"
        >
          <h2
            class="text-xl font-semibold text-blue-900 border-b border-blue-300 pb-2"
          >
            หน่วยการเรียนรู้คุณครูจะจัดการเรียนการสอนในปีการศึกษา 2569
          </h2>
          <label class="block text-sm font-medium text-gray-700 mb-2"
            >(เลือกได้มากกว่า 1 ข้อ และเลือกอย่างน้อย 4 หน่วยการเรียนรู้) *</label
          >

          <div class="space-y-3 mt-2">
            {
              [
                "หน่วยที่ 1 ความสำคัญของแนวคิดเชิงคำนวณ (Concept)",
                "หน่วยที่ 2 แนวคิดเชิงนามธรรม (Abstraction)",
                "หน่วยที่ 3 การแยกส่วนประกอบ (Decomposition)",
                "หน่วยที่ 4  การพิจารณารูปแบบ (Pattern Recognition)", // สังเกต: ตรงนี้มีเว้นวรรค 2 เคาะ ตามต้นฉบับ Google Form เป๊ะๆ
                "หน่วยที่ 5 การออกแบบขั้นตอน (Algorithm)",
                "หน่วยที่ 6 การประยุกต์ใช้แนวคิดเชิงคำนวณ (Computational Thinking)",
                "หน่วยที่ 7 รู้ทันสื่อ (Media Literacy)",
                "หน่วยที่ 8 เท่าทันเทคโนโลยี (Tech Literacy)",
                "หน่วยที่ 9 การปฏิบัติการ Self Study การเขียนโปรแกรมภาษา Python",
                "หน่วยที่ 10 เท่าทันเทคโนโลยีและภัยไซเบอร์ (Tech and Cyber Literacy) แผนการสอนจากเวิร์คชอป Lessons Learned ปี 2569",
              ].map((unit) => (
                <label class="flex items-start bg-white p-3 rounded-md border border-blue-100 hover:border-blue-300 cursor-pointer transition">
                  <input
                    type="checkbox"
                    name="entry.1030308195"
                    value={unit}
                    class="mt-1 form-checkbox h-5 w-5 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500"
                  />
                  <span class="ml-3 text-sm text-gray-700 leading-tight">
                    {unit}
                  </span>
                </label>
              ))
            }
          </div>
          <p id="unit-error" class="hidden text-red-500 text-sm mt-2">
            กรุณาเลือกหน่วยการเรียนรู้อย่างน้อย 4 ข้อ
          </p>
        </section>

        <section class="bg-yellow-50 p-6 rounded-lg border border-yellow-200">
          <p class="font-medium text-gray-800 mb-4">
            คุณครูมีความประสงค์เข้าร่วมโครงการ Samsung Innovation Campus ในปี
            2569 *
          </p>

          <div class="space-y-3">
            <label class="flex items-start cursor-pointer">
              <input
                type="checkbox"
                name="entry.301327575"
                value="รับทราบบันทึกข้อตกลงการดำเนินโครงการในปี 2569 และยินดีร่วมโครงการ"
                required
                class="mt-1 form-checkbox h-5 w-5 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500"
              />
              <span
                class="ml-3 text-sm text-gray-800 font-medium leading-relaxed"
              >
                รับทราบบันทึกข้อตกลงการดำเนินโครงการในปี 2569
                และยินดีร่วมโครงการ
              </span>
            </label>
          </div>
        </section>

        <div class="text-center pt-4">
          <button
            type="submit"
            class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-10 rounded-lg shadow-lg transition duration-300 transform hover:-translate-y-1 text-lg"
          >
            ส่งข้อมูล
          </button>
        </div>
      </form>

      <iframe
        name="hidden_iframe"
        id="hidden_iframe"
        style="display:none;"
        onload="if(window.iframeLoaded) window.iframeLoaded();"></iframe>

      <div
        id="thankyou-message"
        class="hidden fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center z-50"
      >
        <div
          class="bg-white p-8 rounded-lg shadow-xl text-center max-w-sm mx-4"
        >
          <div class="text-green-500 text-5xl mb-4">✓</div>
          <h3 class="text-2xl font-bold text-gray-800 mb-2">
            บันทึกข้อมูลสำเร็จ!
          </h3>
          <p class="text-gray-600 mb-6">
            ขอบคุณสำหรับข้อมูล ทางโครงการฯ ได้รับข้อมูลเรียบร้อยแล้ว<br />
            <span class="text-sm text-gray-500"
              >(ท่านสามารถปิดหน้านี้ได้เลย)</span
            >
          </p>
          <button
            type="button"
            onclick="closePopupAndReset()"
            class="bg-blue-600 text-white py-2 px-6 rounded-lg hover:bg-blue-700 transition"
          >
            ตกลง
          </button>
        </div>
      </div>

      <script is:inline type="module" define:vars={{ supabaseUrl, supabaseKey }}
      >
        import { createClient } from "https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm";

        // 1. เปลี่ยนจาก const เป็น window.supabase เพื่อให้เป็น Global
        window.supabase = createClient(supabaseUrl, supabaseKey);

        // ฟังก์ชันดึงข้อมูลมากรอกล่วงหน้า (Auto-fill)
        async function prefillForm() {
          try {
            // 2. เรียกใช้ผ่าน window.supabase
            const {
              data: { session },
            } = await window.supabase.auth.getSession();
            if (!session) return;

            const { data: profile, error } = await window.supabase
              .from("profiles")
              .select("*")
              .eq("id", session.user.id)
              .single();

            if (error || !profile) return;

            const nameInput = document.querySelector(
              'input[name="entry.2120597359"]',
            );
            const phoneInput = document.querySelector(
              'input[name="entry.1652591964"]',
            );
            const emailInput = document.querySelector(
              'input[name="entry.58179007"]',
            );
            const schoolInput = document.querySelector(
              'input[name="entry.381655348"]',
            );

            const fullName =
              `${profile.first_name_th || ""} ${profile.last_name_th || ""}`.trim();

            if (nameInput && fullName) nameInput.value = fullName;
            if (phoneInput && profile.phone_number)
              phoneInput.value = profile.phone_number;
            if (emailInput && profile.email) emailInput.value = profile.email;
            if (schoolInput && profile.school_name)
              schoolInput.value = profile.school_name;
          } catch (err) {
            console.error("Error prefilling form:", err.message);
          }
        }

        document.addEventListener("DOMContentLoaded", prefillForm);

        // สคริปต์ควบคุม Iframe เดิม
        window.isSubmitted = false;
        window.iframeLoaded = function () {
          if (window.isSubmitted) {
            document
              .getElementById("thankyou-message")
              .classList.remove("hidden");
            window.isSubmitted = false;
          }
        };

        window.closePopupAndReset = function () {
          document.getElementById("thankyou-message").classList.add("hidden");
          document.getElementById("reportForm").reset();

          // --- สิ่งที่เพิ่มเข้ามา: คืนค่าปุ่มให้กลับมากดได้เหมือนเดิม ---
          const submitBtn = document.querySelector('button[type="submit"]');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = "ส่งข้อมูล";
            submitBtn.classList.remove("opacity-50", "cursor-not-allowed");
          }
          // ----------------------------------------

          window.scrollTo(0, 0);
        };

        // ฟังก์ชันตรวจสอบฟอร์ม
        window.validateForm = function () {
          let isValid = true;
          const grades = document.querySelectorAll(
            'input[name="entry.193034328"]:checked',
          );
          const gradeError = document.getElementById("grade-error");
          if (grades.length === 0) {
            gradeError.classList.remove("hidden");
            isValid = false;
          } else {
            gradeError.classList.add("hidden");
          }

          const units = document.querySelectorAll(
            'input[name="entry.1030308195"]:checked',
          );
          const unitError = document.getElementById("unit-error");
          if (units.length < 4) {
            unitError.classList.remove("hidden");
            isValid = false;
          } else {
            unitError.classList.add("hidden");
          }

          if (!isValid) {
            alert("กรุณากรอกข้อมูลและเลือกหน่วยการเรียนรู้ให้ครบถ้วน");
          }
          return isValid;
        };

        // ฟังก์ชันกดส่งข้อมูล
        window.handleSubmit = async function (e) {
          e.preventDefault();

          // --- สิ่งที่เพิ่มเข้ามา: ล็อกปุ่มป้องกันการกดเบิ้ล ---
          const submitBtn = document.querySelector('button[type="submit"]');
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = "กำลังส่งข้อมูล...";
            submitBtn.classList.add("opacity-50", "cursor-not-allowed");
          }
          // ----------------------------------------

          if (window.validateForm()) {
            const form = document.getElementById("reportForm");
            try {
              // เช็ค Session
              const {
                data: { session },
              } = await window.supabase.auth.getSession();

              if (session) {
                console.log("Logged in user: submitting to Google Form");
              } else {
                console.log("Guest user: submitting to Google Form");
              }

              // สั่งให้ฟอร์มส่งไปที่ Google Form
              window.isSubmitted = true;
              form.submit();
            } catch (err) {
              console.error("Auth error:", err.message);
              // ถึงแม้จะเช็ค Auth พลาด ก็ยังให้ส่งเข้า Google Form ได้
              window.isSubmitted = true;
              form.submit();
            }
          } else {
            // --- สิ่งที่เพิ่มเข้ามา: ถ้ากรอกฟอร์มไม่ครบ ให้ปลดล็อกปุ่มกลับมา ---
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = "ส่งข้อมูล";
              submitBtn.classList.remove("opacity-50", "cursor-not-allowed");
            }
          }
          return false;
        };
      </script>
    </div>
  </main>
</Layout>
