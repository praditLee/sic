      <script is:inline>
        // --- 1. จัดการเรื่อง "สังกัด" (อื่นๆ) ---
        function handleSangkatChange() {
          const select = document.getElementById("sangkat_select");
          const uiInput = document.getElementById("sangkat_other_input");

          // Input ที่จะส่งค่าไป Google
          const mainInput = document.getElementById("real_sangkat");
          const otherInput = document.getElementById("other_response_sangkat");

          if (select.value === "other_trigger") {
            // กรณีเลือก "อื่นๆ"
            uiInput.classList.remove("hidden");
            uiInput.setAttribute("required", "true");

            // ตั้งค่า Main ID เป็นค่าพิเศษของ Google Form
            mainInput.value = "__other_option__";

            // เตรียมรับค่าจากช่องพิมพ์
            otherInput.value = uiInput.value;
          } else {
            // กรณีเลือกตัวเลือกปกติ
            uiInput.classList.add("hidden");
            uiInput.removeAttribute("required");
            uiInput.value = ""; // ล้างค่าทิ้ง

            // ส่งค่าตามที่เลือกเข้า Main ID
            mainInput.value = select.value;
            // ล้างค่าช่อง Other
            otherInput.value = "";
          }
        }

        function updateSangkatValue() {
          const uiInput = document.getElementById("sangkat_other_input");
          const otherInput = document.getElementById("other_response_sangkat");

          // อัปเดตข้อความที่จะส่งไป Google ในช่อง Other Response
          otherInput.value = uiInput.value;
        }

        // --- 2. จัดการจำนวนครู ---
        function toggleTeachers(count) {
          const teacher3Section = document.getElementById("teacher3-section");
          const teacher3Inputs = document.querySelectorAll(".teacher3-input");

          if (count === 3) {
            teacher3Section.classList.remove("hidden");
            teacher3Inputs.forEach((input) =>
              input.setAttribute("required", "true"),
            );
          } else {
            teacher3Section.classList.add("hidden");
            teacher3Inputs.forEach((input) =>
              input.removeAttribute("required"),
            );
          }
        }

        // --- 3. ตรวจสอบข้อมูลก่อนส่ง ---
        function validateForm() {
          // เช็คสังกัดอีกทีเพื่อความชัวร์
          const realSangkat = document.getElementById("real_sangkat");
          if (!realSangkat.value) {
            alert("กรุณาระบุสังกัด");
            return false;
          }
          // --- เช็คระดับชั้น (ต้องเลือกอย่างน้อย 1 อัน) ---
          const checkboxes = document.querySelectorAll(
            'input[name="entry.1981480719"]:checked',
          );
          const errorMsg = document.getElementById("grade-error");

          if (checkboxes.length === 0) {
            // ถ้าไม่มีการติ๊กเลย
            errorMsg.classList.remove("hidden"); // แสดงข้อความสีแดง
            alert("กรุณาระบุระดับชั้นที่รับผิดชอบสอน"); // แจ้งเตือน
            return false; // ห้ามส่งฟอร์ม
          } else {
            // ถ้ามีการติ๊กแล้ว
            errorMsg.classList.add("hidden"); // ซ่อนข้อความสีแดง
          }

          // แสดงหน้าต่างขอบคุณ
          setTimeout(function () {
            document
              .getElementById("thankyou-message")
              .classList.remove("hidden");
            document.getElementById("registerForm").reset();
            // รีเซ็ตค่าสังกัดกลับเป็นค่าเริ่มต้น
            document.getElementById("sangkat_other").classList.add("hidden");
          }, 500);
          return true;
        }
      </script>
