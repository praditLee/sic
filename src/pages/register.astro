        action="https://docs.google.com/forms/d/e/1FAIpQLSdOYf1-KmQPdVeLD3UyDR_im8lSvaFjwhWLp1h_gnir-Ey-dg/formResponse"
        method="POST"
        onsubmit="return validateForm()"
        class="p-8 space-y-8"
        id="registerForm"
      >
        <section class="space-y-4">
          <h2 class="text-xl font-semibold text-gray-800 border-b pb-2">
            1. ข้อมูลโรงเรียน
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700"
                >ชื่อโรงเรียน *</label
              >
              <input
                type="text"
                name="entry.220263959"
                required
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm border p-2 focus:border-indigo-500 focus:ring-indigo-500"
                placeholder="ระบุชื่อโรงเรียน"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700"
                >สังกัด *</label
              >

              <input type="hidden" name="entry.1507564259" id="real_sangkat" />

              <input
                type="hidden"
                name="entry.1507564259.other_option_response"
                id="other_response_sangkat"
              />

              <select
                id="sangkat_select"
                onchange="handleSangkatChange()"
                class="mt-1 block w-full border-gray-300 border p-2 rounded shadow-sm"
              >
                <option value="">เลือกสังกัด</option>
                <option value="สพฐ.">สพฐ.</option>
                <option value="เอกชน">เอกชน</option>
                <option value="องค์การปกครองส่วนท้องถิ่น"
                  >องค์การปกครองส่วนท้องถิ่น</option
                >
                <option value="โรงเรียนสาธิต">โรงเรียนสาธิต</option>
                <option value="other_trigger">อื่น ๆ (โปรดระบุ)</option>
              </select>

              <input
                type="text"
                id="sangkat_other_input"
                placeholder="โปรดระบุสังกัด"
                oninput="updateSangkatValue()"
                class="hidden mt-2 block w-full border-gray-300 border p-2 rounded shadow-sm bg-gray-50 focus:bg-white transition"
              />
            </div>
            <div class="md:col-span-2">
              <label class="block text-sm font-medium text-gray-700"
                >ข้อมูลที่อยู่โรงเรียน *</label
              >
              <textarea
                name="entry.1922239376"
                rows="2"
                required
                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm border p-2"
                placeholder="เลขที่, ตำบล, อำเภอ"></textarea>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700"
                >จังหวัด *</label
              >
              <input
                list="provinces-list"
                name="entry.56667219"
                required
                class="mt-1 block w-full border-gray-300 border p-2 rounded shadow-sm"
                placeholder="พิมพ์ชื่อจังหวัดเพื่อค้นหา..."
              />
              <datalist id="provinces-list">
                {provinces.map((province) => <option value={province} />)}
