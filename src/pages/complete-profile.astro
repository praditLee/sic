---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import { getSessionClient } from "../lib/supabase";

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

// 1. เรียกใช้ Supabase แบบอ่าน Cookies
const supabase = getSessionClient(Astro.request, Astro.cookies);

// 2. ขอข้อมูล User ปัจจุบัน
const {
  data: { user },
} = await supabase.auth.getUser();

// 3. ถ้าไม่มี User (ล็อกอินไม่ผ่าน/ไม่ได้ล็อกอิน) ให้เตะกลับไปหน้า Login
if (!user) {
  return Astro.redirect("/login");
}

// ✅ ตอนนี้เรามั่นใจ 100% ว่า user มีข้อมูลแน่นอน
const userEmail = user.email;

// 3. ดึงข้อมูลจากตาราง Whitelist (eligible_students) โดยใช้ email เป็นตัวหา
const { data: eligibleData, error } = await supabase
  .from("eligible_students")
  .select("*")
  .eq("email", user.email) // หาแถวที่ email ตรงกับคนที่ Login
  .single(); // เอาแค่แถวเดียว

// 4. ทำความสะอาดข้อมูล (Data Cleaning) ตามที่เราคุยกันไว้
// กรองเอาเฉพาะ A-Z สำหรับชื่อภาษาอังกฤษ
const firstNameEnClean = (eligibleData?.first_name_en || "").replace(
  /[^A-Za-z\s]/g,
  "",
);
const lastNameEnClean = (eligibleData?.last_name_en || "").replace(
  /[^A-Za-z\s]/g,
  "",
);

// จัดการเบอร์โทรศัพท์ให้เป็น 10 หลัก
let phoneClean = (eligibleData?.phone_number || "").replace(/[-\s]/g, "");
if (phoneClean.length === 9 && !phoneClean.startsWith("0")) {
  phoneClean = "0" + phoneClean;
}
---

<Layout title="ตั้งค่าโปรไฟล์ส่วนตัว | SIC 2026">
  <main class="flex-1 bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div
      class="max-w-3xl mx-auto bg-white shadow-xl rounded-lg overflow-hidden"
    >
      <div class="bg-blue-600 p-6 text-white text-center">
        <h1 class="text-2xl font-bold">ตั้งค่าโปรไฟล์ส่วนตัว</h1>
        <p class="text-blue-100 text-sm mt-1">
          กรุณากรอกข้อมูลให้ครบถ้วนเพื่อความสะดวกในการใช้งานระบบ
        </p>
      </div>

      <form id="profileForm" class="p-8 space-y-6">
        <section class="space-y-4">
          <h2 class="text-lg font-semibold text-gray-800 border-b pb-2">
            ข้อมูลพื้นฐาน
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700"
                >ชื่อ (ภาษาไทย) *</label
              >
              <input
                type="text"
                name="first_name_th"
                required
                pattern="^[ก-๙\s]+$"
                title="กรุณากรอกภาษาไทยเท่านั้น"
                class="mt-1 block w-full border border-gray-300 rounded-md p-2"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700"
                >นามสกุล (ภาษาไทย) *</label
              >
              <input
                type="text"
                name="last_name_th"
                required
                pattern="^[ก-๙\s]+$"
                title="กรุณากรอกภาษาไทยเท่านั้น"
                class="mt-1 block w-full border border-gray-300 rounded-md p-2"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700"
                >First Name (English) *</label
              >
              <input
                type="text"
                name="first_name_en"
                value={firstNameEnClean}
                required
                pattern="^[A-Za-z\s]+$"
                title="Please enter English characters only"
                placeholder="For Certificate"
                class="mt-1 block w-full border border-gray-300 rounded-md p-2"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700"
                >Last Name (English) *</label
              >
              <input
                type="text"
                name="last_name_en"
                value={lastNameEnClean}
                required
                pattern="^[A-Za-z\s]+$"
                title="Please enter English characters only"
                placeholder="For Certificate"
                class="mt-1 block w-full border border-gray-300 rounded-md p-2"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700"
                >วัน/เดือน/ปี เกิด *</label
              >
              <input
                type="date"
                name="date_of_birth"
                required
                class="mt-1 block w-full border border-gray-300 rounded-md p-2"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700"
                >เบอร์โทรศัพท์ *</label
              >
              <input
                type="tel"
                name="phone_number"
                required
                value={phoneClean}
                class="mt-1 block w-full border border-gray-300 rounded-md p-2"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700"
                >Email</label
              >
              <input
                type="email"
                name="email"
                value={userEmail}
                readonly
                class="mt-1 block w-full bg-gray-100 border border-gray-300 rounded-md p-2"
              />
            </div>
          </div>
        </section>

        <section class="space-y-4 pt-4">
          <h2 class="text-lg font-semibold text-gray-800 border-b pb-2">
            สถานะและอาชีพ
          </h2>
          <div>
            <label class="block text-sm font-medium text-gray-700"
              >อาชีพปัจจุบัน *</label
            >
            <select
              id="occupationSelect"
              name="occupation"
              required
              class="mt-1 block w-full border border-gray-300 p-2 rounded-md"
            >
              <option value="">-- กรุณาเลือก --</option>
              <option value="teacher">คุณครู / อาจารย์</option>
              <option value="student">นักเรียน / นักศึกษา</option>
              <option value="general">บุคคลทั่วไป</option>
            </select>
          </div>

          <div
            id="dynamicFields"
            class="space-y-4 bg-gray-50 p-4 rounded-md border border-dashed border-gray-300"
          >
            <p class="text-gray-500 text-sm italic text-center">
              กรุณาเลือกอาชีพเพื่อกรอกข้อมูลเพิ่มเติม
            </p>
          </div>
        </section>
        <section class="space-y-4 pt-6 border-t border-gray-200">
          <div class="flex items-start">
            <div class="flex items-center h-5">
              <input
                id="consent_project"
                name="consent_project"
                type="checkbox"
                required
                class="focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 rounded cursor-pointer"
              />
            </div>
            <div class="ml-3 text-sm">
              <label
                for="consent_project"
                class="font-medium text-gray-700 cursor-pointer"
              >
                โดยการลงทะเบียน ข้าพเจ้ารับทราบและตกลงให้ บริษัท ไทยซัมซุง
                อิเลคโทรนิคส์ จำกัด เก็บรวบรวม ใช้ และ/หรือ
                เปิดเผยข้อมูลส่วนบุคคลของข้าพเจ้าเพื่อวัตถุประสงค์ในการเข้าร่วมโครงการ
                Samsung Innovation Campus โดยการเก็บรวบรวม ใช้ และ/หรือ
                เปิดเผยข้อมูลส่วนบุคคลจะเป็นไปตามนโยบายการเก็บรักษาข้อมูลส่วนตัวของโครงการ
                Samsung Innovation Campus อ่านนโยบายได้ที่หน้า <a
                  href="/privacy-policy"
                  class="text-blue-600 hover:underline"
                  target="_blank">Privacy Policy</a
                >
                <span class="text-red-500">*</span>
              </label>
            </div>
          </div>

          <div class="flex items-start">
            <div class="flex items-center h-5">
              <input
                id="consent_marketing"
                name="consent_marketing"
                type="checkbox"
                class="focus:ring-blue-500 h-4 w-4 text-blue-600 border-gray-300 rounded cursor-pointer"
              />
            </div>
            <div class="ml-3 text-sm">
              <label
                for="consent_marketing"
                class="text-gray-600 cursor-pointer"
              >
                ข้าพเจ้ายินดีรับข้อมูลข่าวสารเกี่ยวกับผลิตภัณฑ์ การให้บริการ
                รวมถึงโปรโมชั่นต่างๆ เกี่ยวกับผลิตภัณฑ์และการให้บริการของบริษัท
                ไทยซัมซุง อิเลคโทรนิคส์ จำกัด
              </label>
            </div>
          </div>
        </section>
        <div class="pt-6">
          <button
            type="submit"
            id="saveBtn"
            class="w-full bg-blue-600 text-white py-3 rounded-lg font-bold hover:bg-blue-700 transition shadow-lg"
          >
            บันทึกข้อมูลและเข้าสู่ระบบ
          </button>
        </div>
      </form>
    </div>
  </main>

  <script>
    // ✅ 1. นำเข้า supabase จากไฟล์ lib ที่รองรับ Cookies
    import { supabase } from "../lib/supabase";

    const occupationSelect = document.getElementById("occupationSelect");
    const dynamicFields = document.getElementById("dynamicFields");

    // --- ระบบดักจับการกรอกภาษา ไทย/อังกฤษ ---
    const setupLanguageValidation = () => {
      // 1. ดึงช่องกรอกข้อมูลภาษาไทยมาทั้งหมด
      const thInputs = document.querySelectorAll(
        'input[name="first_name_th"], input[name="last_name_th"]',
      );
      // 2. ดึงช่องกรอกข้อมูลภาษาอังกฤษมาทั้งหมด
      const enInputs = document.querySelectorAll(
        'input[name="first_name_en"], input[name="last_name_en"]',
      );

      // กฎสำหรับภาษาไทย: อนุญาตเฉพาะ ก-ฮ, สระ, วรรณยุกต์ (ก-๙) และช่องว่าง (\s)
      thInputs.forEach((input) => {
        input.addEventListener("input", (e) => {
          const target = e.target;
          // ถ้าพิมพ์ตัวอักษรอื่นที่ไม่ใช่ภาษาไทย ให้แทนที่ด้วยความว่างเปล่า (ลบทิ้ง)
          target.value = target.value.replace(/[^ก-๙\s]/g, "");
        });
      });

      // กฎสำหรับภาษาอังกฤษ: อนุญาตเฉพาะ A-Z, a-z และช่องว่าง (\s)
      enInputs.forEach((input) => {
        input.addEventListener("input", (e) => {
          const target = e.target;
          // ถ้าพิมพ์ตัวอักษรอื่นที่ไม่ใช่ภาษาอังกฤษ ให้แทนที่ด้วยความว่างเปล่า (ลบทิ้ง)
          target.value = target.value.replace(/[^A-Za-z\s]/g, "");
        });
      });
    };

    // อย่าลืมเรียกใช้ฟังก์ชันเพื่อให้ระบบเริ่มทำงาน
    setupLanguageValidation();

    // 1. จัดการการแสดงผลช่องกรอกตามอาชีพ (โค้ดเดิม)
    occupationSelect?.addEventListener("change", (e) => {
      const val = (e.target as HTMLSelectElement).value;
      let html = "";

      if (val === "teacher") {
        html = `
        <div class="grid grid-cols-1 gap-4">
          <div><label class="block text-sm font-medium">ชื่อโรงเรียน *</label><input type="text" name="school_name" required class="mt-1 block w-full border p-2 rounded"></div>
          <div><label class="block text-sm font-medium">สังกัด (เช่น สพฐ.)</label><input type="text" name="sangkat" class="mt-1 block w-full border p-2 rounded"></div>
          <div><label class="block text-sm font-medium">ที่อยู่โรงเรียน (จังหวัด)</label><input type="text" name="province" class="mt-1 block w-full border p-2 rounded"></div>
        </div>
      `;
      } else if (val === "student") {
        html = `
        <div class="grid grid-cols-1 gap-4">
          <div><label class="block text-sm font-medium">ชื่อสถานศึกษา *</label><input type="text" id="student_school" name="school_name" required class="mt-1 block w-full border border-gray-300 p-2 rounded"></div>
          <div><label class="block text-sm font-medium">ระดับชั้นที่กำลังศึกษา *</label><input type="text" name="study_grade" required class="mt-1 block w-full border border-gray-300 p-2 rounded"></div>
          <div class="mt-2"><label class="flex items-center cursor-pointer"><input type="checkbox" id="hasTeacherCheckbox" class="form-checkbox h-4 w-4 text-blue-600 rounded"><span class="ml-2 text-sm text-gray-700">มีคุณครูที่ปรึกษา/ผู้แนะนำเข้าร่วมโครงการ</span></label></div>
          <div id="teacherSearchBox" class="hidden bg-blue-50 p-3 rounded border border-blue-100">
            <label class="block text-sm font-medium text-blue-800">ค้นหาและเลือกชื่อคุณครู *</label>
            <input type="text" name="referred_teacher" id="referred_teacher_input" list="teacherList" placeholder="พิมพ์ชื่อเพื่อค้นหา..." class="mt-1 block w-full border border-gray-300 p-2 rounded">
            <datalist id="teacherList"></datalist>
          </div>
        </div>
      `;

        setTimeout(() => {
          const hasTeacherCheckbox = document.getElementById(
            "hasTeacherCheckbox",
          ) as HTMLInputElement;
          const teacherSearchBox = document.getElementById("teacherSearchBox");
          const referredTeacherInput = document.getElementById(
            "referred_teacher_input",
          ) as HTMLInputElement;
          const teacherList = document.getElementById("teacherList");

          hasTeacherCheckbox?.addEventListener("change", (e) => {
            if ((e.target as HTMLInputElement).checked) {
              teacherSearchBox?.classList.remove("hidden");
              referredTeacherInput?.setAttribute("required", "required");
            } else {
              teacherSearchBox?.classList.add("hidden");
              referredTeacherInput?.removeAttribute("required");
              referredTeacherInput!.value = "";
            }
          });

          referredTeacherInput?.addEventListener("input", async (e) => {
            const keyword = (e.target as HTMLInputElement).value.trim();
            if (keyword.length < 2) return;
            teacherList!.innerHTML = "";
            const { data, error } = await supabase
              .from("profiles")
              .select("first_name_th, last_name_th, school_name")
              .eq("occupation", "teacher")
              .or(
                `first_name_th.ilike.%${keyword}%,last_name_th.ilike.%${keyword}%`,
              )
              .limit(10);
            if (!error && data) {
              data.forEach((teacher) => {
                const option = document.createElement("option");
                option.value = `${teacher.first_name_th} ${teacher.last_name_th} (${teacher.school_name || "ไม่ระบุโรงเรียน"})`;
                teacherList?.appendChild(option);
              });
            }
          });
        }, 50);
      } else {
        html = `<p class="text-center text-gray-600">ไม่ต้องกรอกข้อมูลเพิ่มเติม</p>`;
      }
      dynamicFields!.innerHTML = html;
    });

    // 2. บันทึกข้อมูลลง Supabase (แก้ไขส่วนดึง Session)
    document
      .getElementById("profileForm")
      .addEventListener("submit", async (e) => {
        e.preventDefault();
        const saveBtn = document.getElementById("saveBtn");
        saveBtn.disabled = true;
        saveBtn.textContent = "กำลังบันทึก...";

        const formData = new FormData(e.target);

        // แปลงข้อมูลจาก Form เป็น Object
        const rawData = Object.fromEntries(formData.entries());

        // ✅ จัดการค่า Checkbox ให้เป็น Boolean (True/False)
        const profileData = {
          ...rawData,
          consent_project: formData.get("consent_project") === "on",
          consent_marketing: formData.get("consent_marketing") === "on",
        };

        const {
          data: { session },
        } = await supabase.auth.getSession();

        const { error } = await supabase
          .from("profiles")
          .update({
            ...profileData,
            is_profile_complete: true,
          })
          .eq("id", session.user.id);

        if (error) {
          alert("เกิดข้อผิดพลาด: " + error.message);
          saveBtn.disabled = false;
          saveBtn.textContent = "บันทึกข้อมูลและเข้าสู่ระบบ";
        } else {
          window.location.href = "/check-profile";
        }
      });
  </script>
</Layout>
